// Diagram for MonthOfYear
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		DateTimeDescription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DateTimeDescription</TD></TR></TABLE>> URL="../DateTimeDescription" margin=0]
	}
	MonthOfYear [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MonthOfYear</TD></TR><TR><TD ALIGN="LEFT">redefines day</TD></TR><TR><TD ALIGN="LEFT">hour : xsd:nonNegativeInteger</TD></TR><TR><TD ALIGN="LEFT">minute : xsd:nonNegativeInteger</TD></TR><TR><TD ALIGN="LEFT">redefines month</TD></TR><TR><TD ALIGN="LEFT">second : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">week : xsd:nonNegativeInteger</TD></TR><TR><TD ALIGN="LEFT">redefines year</TD></TR></TABLE>> URL="../MonthOfYear" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	MonthOfYear -> DateTimeDescription [arrowhead=onormal style=solid]
}
