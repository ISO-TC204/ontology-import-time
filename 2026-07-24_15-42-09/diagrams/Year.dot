// Diagram for Year
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		DurationDescription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DurationDescription</TD></TR></TABLE>> URL="../DurationDescription" margin=0]
	}
	Year [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Year</TD></TR><TR><TD ALIGN="LEFT">redefines days : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines hours : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines minutes : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines months : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines seconds : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines weeks : xsd:decimal</TD></TR><TR><TD ALIGN="LEFT">redefines years : xsd:decimal</TD></TR></TABLE>> URL="../Year" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	Year -> DurationDescription [arrowhead=onormal style=solid]
}
